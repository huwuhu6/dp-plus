{"caseCode":"MAIN_V2_CRITERIA_OVERWRITE","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"冻结语义：后轮明确预算覆盖前轮 hardMax；本地 fixture 仅提供位置，不参与 gold。","turns":[{"message":"找人均100以内的火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"预算改成150"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"criteria.cuisine.include":"火锅","criteria.budget.hardMax":150}}]}
{"caseCode":"MAIN_V2_CRITERIA_CLEAR","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"冻结语义：clear 只清除 budget，不清除距离和菜系。","turns":[{"message":"找3公里内人均100以内火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"不要预算限制，距离保留"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"semantic.cleared":{"contains":"BUDGET"},"criteria.budget.hardMax":{"null":true},"criteria.distance.hardMaxKm":3,"criteria.cuisine.include":"火锅"}}]}
{"caseCode":"MAIN_V2_CRITERIA_RELATIVE","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"PRICE LOWER 是排序偏好，不得转写为 hard budget。","turns":[{"message":"推荐附近烧烤","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"便宜一点"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"semantic.relativePreferences":{"contains":{"dimension":"PRICE","direction":"LOWER"}},"criteria.budget.hardMax":{"null":true}}}]}
{"caseCode":"MAIN_V2_CRITERIA_MULTI_PATCH","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"同轮多个明确硬条件必须共同进入 canonical criteria。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"3公里内，人均120以内"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"criteria.distance.hardMaxKm":3,"criteria.budget.hardMax":120}}]}
{"caseCode":"MAIN_V2_TASK_RESTORE_EARLIEST","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"RESTORE 依据 task selector，不按当前活跃任务猜测。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"新开一个任务找日料"},{"message":"恢复最早的推荐任务"},{"message":"再给几个"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":3,"assertions":{"taskLifecycle":"ACTIVE","criteria.cuisine.include":"火锅","semantic.taskDirective":"RESTORE"}},{"turn":4,"assertions":{"criteria.cuisine.include":"火锅"}}]}
{"caseCode":"MAIN_V2_TASK_RESTORE_UNRESOLVED","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"多个历史 task 下不明确恢复必须澄清，且不展示候选。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"新开一个任务找日料"},{"message":"恢复之前那个"}],"expectedFinalStatus":"CLARIFYING","expectedV2Outcomes":[{"turn":3,"assertions":{"finalCandidates":{"empty":true},"groundedEntities":{"empty":true}}}]}
{"caseCode":"MAIN_V2_TASK_ABANDON_INVALIDATES_VISIBLE","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"ABANDON 是 lifecycle mutation，并必须撤销 active visible candidate projection。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"结束这个推荐任务"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"semantic.taskDirective":"ABANDON","taskLifecycle":"ABANDONED","finalCandidates":{"empty":true}}}],"expectedRelations":[{"fromTurn":1,"toTurn":2,"type":"candidatePool","relation":"INVALIDATED"}]}
{"caseCode":"MAIN_V2_REFERENCE_FIRST_IDENTITY","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"本地 fixture 前提：首轮 visible batch 至少含一项；ordinal 只绑定该 batch 的 identity。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"第一家几点营业？"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"groundedEntities":{"nonEmpty":true},"semantic.requestKinds":{"contains":"FactQueryRequest"}}}],"expectedRelations":[{"fromTurn":1,"toTurn":2,"type":"groundedOrdinal","relation":"EQUALS_VISIBLE","ordinal":1}]}
{"caseCode":"MAIN_V2_REFERENCE_LAST_IDENTITY","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"本地 fixture 前提：首轮 visible batch 非空；last ordinal 不得从全局排序取实体。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"最后一家离我多远？"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"groundedEntities":{"nonEmpty":true}}}]}
{"caseCode":"MAIN_V2_REFERENCE_HISTORY_RESTORE","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"恢复历史 task 后，ordinal 绑定 restored task 的 visible batch。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"新开任务找烧烤"},{"message":"恢复最早任务"},{"message":"第二家怎么样？"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":4,"assertions":{"criteria.cuisine.include":"火锅","groundedEntities":{"nonEmpty":true}}}],"expectedRelations":[{"fromTurn":3,"toTurn":4,"type":"groundedOrdinal","relation":"EQUALS_VISIBLE","ordinal":2}]}
{"caseCode":"MAIN_V2_REFERENCE_UNRESOLVED_ORDINAL","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"越界 ordinal 必须受控澄清，不得 grounding 或展示候选。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"第九家怎么样？"}],"expectedFinalStatus":"CLARIFYING","expectedV2Outcomes":[{"turn":2,"assertions":{"finalCandidates":{"empty":true},"groundedEntities":{"empty":true}}}]}
{"caseCode":"MAIN_V2_FEEDBACK_REJECT","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"实体 REJECT 是 task 级 durable exclusion。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"第一家不要了"},{"message":"换一批"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"semantic.feedbackKinds":{"contains":"REJECT"},"rejectedShopIds":{"nonEmpty":true}}},{"turn":3,"assertions":{"rejectedShopIds":{"nonEmpty":true}}}]}
{"caseCode":"MAIN_V2_FEEDBACK_CRITIQUE","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"CRITIQUE 进入 feedback ledger，不能升级为 reject。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"第一家太贵了"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"semantic.feedbackKinds":{"contains":"CRITIQUE"},"rejectedShopIds":{"empty":true},"feedbackLedger":{"nonEmpty":true}}}]}
{"caseCode":"MAIN_V2_FEEDBACK_BATCH_NEGATIVE","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"Batch negative 只记录 batch feedback，不扩散为逐店 reject。","turns":[{"message":"找附近日料","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"这几家都不喜欢"},{"message":"换一批"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"semantic.feedbackKinds":{"contains":"BATCH_NEGATIVE"},"rejectedShopIds":{"empty":true},"feedbackLedger":{"nonEmpty":true}}}]}
{"caseCode":"MAIN_V2_ALTERNATIVES_DISJOINT","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"本地 fixture 前提：两轮均能生成候选；alternatives 不能重新展示首轮候选。","turns":[{"message":"找附近烧烤","location":{"latitude":26.0745,"longitude":119.2965}},{"message":"换一批"}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":2,"assertions":{"semantic.requestKinds":{"contains":"AlternativesRequest"},"currentVisibleShopIds":{"nonEmpty":true}}}],"expectedRelations":[{"fromTurn":1,"toTurn":2,"type":"recommendations","relation":"DISJOINT"}]}
{"caseCode":"MAIN_V2_LOCATION_DEVICE","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"设备坐标是唯一明确的 nearby search anchor。","turns":[{"message":"找附近火锅","location":{"latitude":26.0745,"longitude":119.2965}}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":1,"assertions":{"searchAnchor.source":"DEVICE"}}]}
{"caseCode":"MAIN_V2_LOCATION_MISSING","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"nearby 或显式距离缺少可靠 anchor 必须澄清。","turns":[{"message":"3公里内找火锅"}],"expectedFinalStatus":"CLARIFYING","expectedV2Outcomes":[{"turn":1,"assertions":{"finalCandidates":{"empty":true}}}]}
{"caseCode":"MAIN_V2_LOCATION_POI_AMBIGUOUS","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"无可确认 POI identity 不得静默用设备或全城替代。","turns":[{"message":"在大学城附近找火锅"}],"expectedFinalStatus":"CLARIFYING","expectedV2Outcomes":[{"turn":1,"assertions":{"finalCandidates":{"empty":true}}}]}
{"caseCode":"MAIN_V2_CONDITIONAL_SEMANTICS","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"仅计分冻结的条件语义和原始 hard distance；fallback 是否执行依赖 world result，故不计入 scored outcome。","turns":[{"message":"如果3公里内没有藏式火锅，就改找烧烤","location":{"latitude":26.0745,"longitude":119.2965}}],"expectedV2Outcomes":[{"turn":1,"assertions":{"semantic.conditionalChangeCount":1,"criteria.distance.hardMaxKm":3}}]}
{"caseCode":"MAIN_V2_HARD_BUDGET","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"hard budget 必须成为 SearchSpec 输入；候选事实由 DeterministicResultVerifier 单测覆盖。","turns":[{"message":"找附近人均80以内火锅","location":{"latitude":26.0745,"longitude":119.2965}}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":1,"assertions":{"criteria.budget.hardMax":80}}]}
{"caseCode":"MAIN_V2_HARD_DISTANCE","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"hard distance 必须成为 SearchSpec 输入；候选距离事实由 DeterministicResultVerifier 单测覆盖。","turns":[{"message":"找附近1公里以内烧烤","location":{"latitude":26.0745,"longitude":119.2965}}],"expectedFinalStatus":"COMPLETED","expectedV2Outcomes":[{"turn":1,"assertions":{"criteria.distance.hardMaxKm":1}}]}
{"caseCode":"MAIN_V2_VERIFICATION_UNSUPPORTED","datasetVersion":"conversation-v2-main-v2","active":true,"notes":"非搜索 unsupported 不适用 hard-result verification，不能被记录为 verified pass。","turns":[{"message":"介绍一下火锅的历史来源"}],"expectedFinalStatus":"UNSUPPORTED","expectedV2Outcomes":[{"turn":1,"assertions":{"decisionStatus":"UNSUPPORTED","verificationStatus":"NOT_APPLICABLE","hardConstraintsVerified":false,"finalCandidates":{"empty":true}}}]}
